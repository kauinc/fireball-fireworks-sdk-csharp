<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Authors>KAU Inc.</Authors>
    <Description>A server-side C# SDK for integrating game servers with the Fireball platform. It sits on your game's backend and acts as the single point of contact for all communication with Fireball — handling player authentication, wallet operations (bets and wins), game session state, client message delivery, jackpots, and multiplayer coordination.</Description>
    <PackageId>Fireball.Fireworks</PackageId>
    <RootNamespace>Fireball.Fireworks</RootNamespace>
    <Configurations>Release;Debug</Configurations>
    <Copyright>Copyright © 2004-2025. All rights reserved.</Copyright>
    <Owners>KAU Inc.</Owners>
    <Title>Fireball Fireworks</Title>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://www.fireballserver.com/</PackageProjectUrl>
    <PackageTags>fireball,fireworks,game,server</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
    <Version>1.1.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fireball.Fireworks.Rng" Version="1.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Polly" Version="8.7.0" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
    <PackageReference Include="Google.Cloud.Firestore" Version="4.3.0" />
    <PackageReference Include="Google.Cloud.Functions.Hosting" Version="3.0.1" />
    <PackageReference Include="Google.Cloud.PubSub.V1" Version="3.36.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
